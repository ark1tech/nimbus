{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx src/server/demo.ts",
    "build": "tsc --noEmit && npm run build:web && npm run build:mcp",
    "build:web": "vite build",
    "build:mcp": "node scripts/build-plugin-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:plugin-mcp": "tsx scripts/smoke-plugin-mcp.ts",
    "test:plugin-runtime": "tsx scripts/smoke-plugin-runtime.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 127.0.0.1",
    "mcp": "tsx src/server/mcp/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@xyflow/react": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "mermaid": "^11.16.0",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.13.1",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "tw-animate-css": "^1.4.0",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "esbuild": "^0.28.1",
    "jsdom": "latest",
    "prettier": "^3.9.5",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
